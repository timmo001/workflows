{
  "name": "@timmo001/workflows-actions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle": "bun run scripts/bundle.ts",
    "bundle:check": "bun run scripts/bundle.ts --check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config scripts/vitest.config.ts",
    "format": "prettier --write \"{src,tests,scripts}/**/*.ts\" oxlint.config.ts package.json tsconfig.json",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.ts\" oxlint.config.ts package.json tsconfig.json",
    "prepare": "effect-tsgo patch --force=false"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "@timmo001/effect-gh": "0.13.2",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@effect/tsgo": "0.68.1",
    "@effect/vitest": "4.1.4",
    "@oxlint/plugins": "1.93.0",
    "@timmo001/oxlint-rules": "0.6.5",
    "@types/bun": "1.4.4",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
