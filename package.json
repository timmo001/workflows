{
  "name": "@timmo001/workflows-actions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle": "bun run scripts/bundle.ts",
    "bundle:check": "bun run scripts/bundle.ts --check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config scripts/vitest.config.ts",
    "format": "prettier --write \"{src,tests,scripts}/**/*.ts\" oxlint.config.ts package.json tsconfig.json",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.ts\" oxlint.config.ts package.json tsconfig.json",
    "validate": "bun run lint && bun run typecheck && bun run test && bun run format:check && bun run bundle:check",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@timmo001/effect-gh": "github:timmo001/effect-gh#d4a3a865a3275b4be71884fe0d625521bfc63171",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/tsgo": "0.39.1",
    "@effect/vitest": "4.0.0-rc.112",
    "@oxlint/plugins": "1.81.0",
    "@timmo001/oxlint-rules": "0.3.0",
    "@types/bun": "1.4.0",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
